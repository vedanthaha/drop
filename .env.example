# Frontend server-side configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-rotated-service-role-key
WORKER_URL=http://localhost:8081
WORKER_SECRET=replace-with-a-long-random-secret

# Worker configuration
PORT=8080
WORKER_ID=local-worker
RESOLVE_TIMEOUT=45s
DOWNLOAD_TIMEOUT=10m
UPLOAD_TIMEOUT=10m
JOB_LEASE_TIMEOUT=15m
JOB_POLL_INTERVAL=5s
JOB_RETENTION=60m
MAX_CONCURRENT_JOBS=1
MAX_FILE_SIZE=5242880000
MAX_REQUEST_BODY=16384
